# Application
PROJECT_NAME="SIH26104 Voice Cloning Detection Platform"
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL in Docker / Production or SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/voice_cloning_db
# For local dev without Postgres: sqlite+aiosqlite:///./voice_cloning.db

# ML Detection Service Configuration
DETECTION_ENGINE=mock
MOCK_MODEL_VERSION=mock-v1

# Audio Limits
MAX_FILE_SIZE_BYTES=26214400
