# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_cloning_db
POSTGRES_PORT=5432

# Backend Configuration
PROJECT_NAME="SIH26104 Voice Cloning Detection Platform"
ENVIRONMENT=development
DEBUG=True
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_cloning_db
# For running without PostgreSQL locally: sqlite+aiosqlite:///./voice_cloning.db

# ML Detection Service Configuration
DETECTION_ENGINE=mock
MOCK_MODEL_VERSION=mock-v1
MAX_FILE_SIZE_BYTES=26214400

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
